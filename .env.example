# ─── Better Auth ───────────────────────────────────────────────────────────────
# Encryption secret (min 32 chars). Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=your_generated_secret_here
# Base URL of the app, no trailing slash. Set to the prod domain in production.
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console → Credentials → OAuth client ID).
# Authorized redirect URI: <BASE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── Email (Resend) ────────────────────────────────────────────────────────────
# Sends the auth OTP emails (email verification + password reset).
RESEND_API_KEY=re_your_resend_api_key
# The domain here must exactly match a verified domain in the Resend dashboard,
# or every send fails with 403. Do NOT wrap the value in quotes: dotenv strips
# them locally, but Coolify passes them through verbatim and Resend then
# rejects the `from` field with a 422 validation_error.
RESEND_FROM_EMAIL=DocGenie <noreply@verification.example.com>

# ─── Database (Postgres) ───────────────────────────────────────────────────────
# Better Auth tables are created in the document_genie schema (via search_path).
DATABASE_URL=postgres://user:password@host:5432/dbname

# ─── Upstash Redis (contact-form rate limiting) ────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ─── Umami Analytics (self-hosted) ─────────────────────────────────────────────
# NEXT_PUBLIC_* → must be present at BUILD time.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://analytics.example.com/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your_umami_website_id

# ─── FastAPI backend ───────────────────────────────────────────────────────────
# The backend (backend/) is private: only the Next.js server calls it, never the
# browser. INTERNAL_API_KEY must equal the value in backend/.env.
BACKEND_API_URL=http://localhost:8765
INTERNAL_API_KEY=same_value_as_in_backend_env

# ─── n8n (contact form only) ───────────────────────────────────────────────────
# The contact form is the one remaining n8n workflow.
N8N_WEBHOOK_BASE_URL=https://your-n8n-instance.com/webhook
N8N_API_KEY=your_api_key_here
N8N_CONTACT_FORM_WEBHOOK_ID=your_webhook_id

# ─── Coolify (deployment) ──────────────────────────────────────────────────────
# Root token for API/MCP setup; deploy token used as the GitHub Actions secret.
COOLIFY_API_TOKEN=your_root_token
COOLIFY_DEPLOY_TOKEN=your_deploy_token
