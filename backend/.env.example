# Backend env (copy to backend/.env). Every value in app/config.py can be overridden here.

# --- Infra ---
# Same database as Better Auth. postgres:// is fine; the backend converts it for asyncpg.
DATABASE_URL=postgres://user:password@host:5432/dbname
OPENAI_API_KEY=sk-your-openai-key
# Shared secret the Next.js proxy sends as X-Internal-Key. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=change-me
# Schema for the app tables and the search path. Leave at the default; the test suite overrides it with a throwaway schema.
# DB_SCHEMA=document_genie

# Object storage. Local dev: MinIO via `docker compose --env-file backend/.env -f docker-compose.dev.yml up -d`
# (run from the repo root; API on 9100, console on 9101). The compose file reads these S3_* values too.
S3_ENDPOINT=http://localhost:9100
S3_BUCKET=docgenie
S3_ACCESS_KEY_ID=docgenie
S3_SECRET_ACCESS_KEY=docgenie-dev-secret
S3_REGION=us-east-1

# --- LLM (defaults shown; uncomment to override) ---
# CHAT_MODEL=gpt-6-luna
# CHAT_REASONING_EFFORT=medium
# CHAT_SERVICE_TIER=default   # "flex" is cheaper but frequently 429s; opt in explicitly
# TITLE_MODEL=gpt-6-luna
# OCR_MODEL=gpt-6-luna
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536
# LLM_TIMEOUT_S=900
# FLEX_FALLBACK_TIER=default
# AGENT_MAX_STEPS=8
# USD per 1M tokens for gpt-6-luna; unset = llm_usage.cost_usd stays NULL
# LLM_INPUT_PRICE_PER_M=
# LLM_OUTPUT_PRICE_PER_M=
# FLEX_PRICE_MULTIPLIER=0.5
# TITLE_MAX_CHARS=60

# --- Limits ---
# MAX_UPLOAD_MB=20
# MAX_PAGES=50
# MAX_CSV_ROWS=10000
# MAX_EXTRACTED_CHARS=2000000
# TXT_WORDS_PER_PAGE=500
# ALLOWED_MIME_TYPES=["application/pdf","text/plain","text/csv","application/vnd.openxmlformats-officedocument.wordprocessingml.document"]   # JSON list

# --- Ingestion ---
# OCR_MIN_CHARS_PER_PAGE=25      # PDFs averaging fewer text chars/page are OCR'd
# OCR_REASONING_EFFORT=low
# OCR_RENDER_SCALE=2.0
# OCR_CONCURRENCY=4
# EMBEDDING_BATCH_SIZE=64
# CSV_ROWS_PER_CHUNK_CHARS=1500
# INGESTION_STALE_MINUTES=10     # a `processing` document older than this is failed + refunded
# INGESTION_SWEEP_INTERVAL_S=300

# --- Retrieval ---
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# RETRIEVAL_TOP_K=8
# RRF_K=60
# HISTORY_WINDOW=20
# RETRIEVAL_CANDIDATES=30        # per ranking (semantic / keyword) before fusion
# SNIPPET_CHARS=240
# CITATION_FOCUS_CHARS=360

# --- Agent tools ---
# DOC_TEXT_MAX_TOKENS=25000      # get_document_text truncation budget
# QUERY_MAX_ROWS=100             # query_table result cap
# QUERY_TIMEOUT_MS=5000          # query_table statement_timeout
# TOOL_RESULT_MAX_CHARS=24000

# --- Dashboard ---
# DASHBOARD_RECENT_LIMIT=5
# DASHBOARD_ACTIVITY_LIMIT=10
# DASHBOARD_USAGE_DAYS=14

# --- Credits ---
# SIGNUP_DOC_CREDITS=5
# SIGNUP_MESSAGE_CREDITS=25
